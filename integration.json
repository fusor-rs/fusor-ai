    ],
    "parity": "target/release/phonon parity dist/model-f32 fixtures/goldens/golden_f32_A.safetensors --threads 8",
    "smoke": [
      "node scripts/node-smoke.mjs dist/model --build web-single --out {out}/web-single.wav",
      "node scripts/node-smoke.mjs dist/model --build web-single-relaxed --out {out}/web-single-relaxed.wav"
    ],
    "e2e": [
      "ASR_PYTHON=.cache/asr/bin/python node e2e/run.mjs --threads 8 --build web-threaded --out {out}/web-threaded",
      "ASR_PYTHON=.cache/asr/bin/python node e2e/run.mjs --threads 8 --build web-threaded-relaxed --out {out}/web-threaded-relaxed"
    ],
    "outputs": [
      ".wav"
    ]
  },
