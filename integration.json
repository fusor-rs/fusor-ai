{
  "ming": {
    "product": "ming-wasm",
    "build": [
      "just model",
      "rm -rf dist/model-f32",
      "target/release/ming compile .cache/Ming-3.0-tts-0.5B dist/model-f32 --profile f32",
      "just runtimes",
      "just page",
      "cd e2e && npm install --no-audit --no-fund --silent && npx playwright install chromium"
    ],
    "bundles": [
      "dist/model",
      "dist/model-f32"
    ],
    "parity": "target/release/ming parity dist/model-f32 fixtures/goldens/ref_f32_A.safetensors --threads 8",
    "smoke": [
      "node scripts/node-smoke.mjs dist/model --build web-single --out {out}/web-single.wav",
      "node scripts/node-smoke.mjs dist/model --build web-single-relaxed --out {out}/web-single-relaxed.wav"
    ],
    "e2e": [
      "node e2e/run.mjs --threads 8 --build web-threaded --out {out}/web-threaded",
      "node e2e/run.mjs --threads 8 --build web-threaded-relaxed --out {out}/web-threaded-relaxed"
    ],
    "outputs": [
      ".wav"
    ]
  },
  "phonon": {
    "product": "phonon-wasm",
    "build": [
      "just model",
      "rm -rf dist/model-f32",
      "target/release/phonon compile .cache/phonon-31m-en dist/model-f32 --profile f32",
      "just runtimes",
      "just page",
      "cd e2e && npm ci --no-audit --no-fund --silent && npx playwright install chromium"
    ],
    "bundles": [
      "dist/model",
